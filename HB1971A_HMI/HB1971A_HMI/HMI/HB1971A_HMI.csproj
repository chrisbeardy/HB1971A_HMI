    <PackageReference Include="HBCommon" Version="1.*" />
    <PackageReference Include="HBControls" Version="1.*" />
    <PackageReference Include="HBDataStorage" Version="1.*" />
    <PackageReference Include="HBLanguage" Version="1.*" />
    <PackageReference Include="HBMessages" Version="1.*" />
    <PackageReference Include="HBSecurity" Version="1.*" />
    <PackageReference Include="HBSystemHandler" Version="1.*" />
    <PackageReference Include="IHBControls" Version="1.*" />
    <PackageReference Include="HBBeckhoffPLC" Version="1.*" />
    <PackageReference Include="HBRemoteServer" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**" />
  </ItemGroup>

</Project>
