    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HB1971A_HMI</RootNamespace>
    <AssemblyName>HB1971A_HMI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
